@model AddMovie

<h1>Add a Movie</h1>

<form method="post">
    <input type="hidden" asp-for="MovieId"/>
    <label asp-for="Title">Movie Title:</label>
    <br/>
    <input asp-for="Title"/>
    <br/>
    <label asp-for="CategoryId">Category:</label>
    <br/>
    <select asp-for="CategoryId">
        <option value="">Select a Category</option>
        @foreach (Category c in ViewBag.Categories)
        {
            <option value="@c.CategoryId">@c.CategoryName</option>
        }
    </select>
    <br/>
    <label asp-for="Year">Year:</label>
    <br/>
    <input asp-for="Year"/>
    <br/>
    <label asp-for="Director">Director:</label>
    <br/>
    <input asp-for="Director"/>
    <br/>
    <label asp-for="Rating">Rating:</label>
    <br/>
    <select asp-for="Rating">
        <option value="G">G</option>
        <option value="PG">PG</option>
        <option value="PG-13">PG-13</option>
        <option value="R">R</option>
        <option value="NR">NR</option>
        <option value="TV-Y7">TV-Y7</option>
        <option value="TV-14">TV-14</option>
        <option value="TV-MA">TV-MA</option>
    </select>
    <br/>
    <label asp-for="Edited">Edited:</label>
    <br/>
    <input type="radio" name="Edited" value="true" checked="checked"/> Yes
    <br/>
    <input type="radio" name="Edited" value="false" checked="checked"/> No
    <br/>
    <label asp-for="LentTo">Lent To:</label>
    <br/>
    <input asp-for="LentTo"/>
    <br/>
    <label asp-for="CopiedToPlex">Copied To Plex</label>
    <br/>
    <input type="radio" name="CopiedToPlex" value="true" checked="checked"/> Yes
    <br/>
    <input type="radio" name="CopiedToPlex" value="false" checked="checked"/> No
    <br/>
    <label asp-for="Notes">Notes:</label>
    <br/>
    <textarea asp-for="Notes"></textarea>
    <br/>
    <br/>

    <button class="btn btn-primary "type="submit">Submit</button>

    <div asp-validation-summary="All"></div>

</form>